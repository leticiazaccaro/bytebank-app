# Copy to .env.local for `npm run dev -w apps/shell` (or set these in your
# hosting provider's project settings for `next build`/`next start`).

# Base URL of the real tech-challenge-2 API, used by the auth Route Handlers
# (packages/shared/src/apiClient.ts) — never hardcoded.
API_BASE_URL=https://tech-challenge-api.example.com

# Origins the shell rewrites "/", "/dashboard/*" and "/transactions/*" to
# (apps/shell/next.config.ts). Read during `next build` — see DEPLOY.md
# "Build-time env vars" for why these must be set before building.
MF_DASHBOARD_ORIGIN=http://localhost:3001
MF_TRANSACTIONS_ORIGIN=http://localhost:3002
