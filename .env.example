# Used by docker-compose.yml (INFRA-01, INFRA-03) — copy to .env and fill in
# before running `docker compose up`.

# Base URL of the real tech-challenge-2 API, read server-side only by each
# zone's Route Handlers (packages/shared/src/apiClient.ts). Never hardcoded.
API_BASE_URL=https://tech-challenge-api.example.com

# Origins the shell rewrites "/" and "/transactions/*" to (apps/shell/next.config.ts).
# Defaults below already match the service names in docker-compose.yml —
# only override if you're running the zones somewhere else (e.g. deployed
# Vercel Preview URLs during local testing against production zones).
# MF_DASHBOARD_ORIGIN=http://mf-dashboard:3001
# MF_TRANSACTIONS_ORIGIN=http://mf-transactions:3002
